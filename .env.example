# Copy to .env for machine-local configuration. Never commit .env.
# Polza API credential; intentionally blank in this public template.
POLZA_API_KEY=

# Operator-selected local model label. Confirm the server model ID before use.
LOCAL_TEST_MODEL=vllm-d3-mini q8

# Before local model loading or inference, check GPU memory and runtime activity.
# Unload other models / stop their identified inference processes only when idle.
# If inference is active, wait 10 minutes, then check again; do not interrupt it.
# Unknown activity is not proof of idleness. Do not stop desktop/system processes.
